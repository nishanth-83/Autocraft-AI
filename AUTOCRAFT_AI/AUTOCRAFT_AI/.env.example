# ============================================================================
# AUTOCRAFT AI — Environment Configuration Example (No Secrets)
# Copy this file to .env and adjust values as needed for your Windows 10/11 PC.
# ============================================================================

AUTOCRAFT_HOST=127.0.0.1
AUTOCRAFT_PORT=8000

# Authorized workspace root directory (all filesystem operations are confined here)
AUTOCRAFT_WORKSPACE_ROOT=./workspace

# Optional semicolon-separated additional allowed directories on Windows
AUTOCRAFT_ALLOWED_PATHS=

# SQLite state and audit database path
AUTOCRAFT_DATABASE_PATH=./workspace/autocraft_state.db

# Browser automation settings ("chrome", "msedge", or "chromium")
AUTOCRAFT_BROWSER_CHANNEL=chromium
AUTOCRAFT_BROWSER_HEADLESS=false
AUTOCRAFT_BROWSER_TIMEOUT_MS=15000

# Execution loop bounds
AUTOCRAFT_STEP_TIMEOUT_SECONDS=30.0
AUTOCRAFT_MAX_STEP_RETRIES=2
AUTOCRAFT_MAX_PLAN_STEPS=25

# Logging level (DEBUG, INFO, WARN, ERROR)
AUTOCRAFT_LOG_LEVEL=INFO
